{
  "name": "llm-ast-validator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "npm run verify:shared-ui && npm run test && npm run build",
    "verify:shared-ui": "tsx scripts/verify-shared-ui.ts",
    "prepare:cohort": "tsx scripts/prepare-cohort.ts",
    "audit:release": "tsx scripts/audit-public-release.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@tanstack/react-query": "^5.101.2",
    "better-sqlite3": "^12.11.1",
    "blockly": "^11.2.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "hono": "^4.12.30",
    "katex": "^0.16.47",
    "openai": "^6.47.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
